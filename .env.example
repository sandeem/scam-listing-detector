# Copy to .env and fill in. NEVER commit .env.

# Glasser key: https://app.glasser.ai (create account, redeem the $10 code)
GLASSER_API_KEY=

# Jev key: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Filled in AFTER `python main.py discover` + inspecting the endpoint (free):
GLASSER_PROVIDER=
GLASSER_ENDPOINT=
# JSON body for the endpoint. "{query}" is replaced with the search text.
# Check the real field name with inspect. "q" is only a guess.
GLASSER_INPUT_TEMPLATE={"q": "{query}"}

# --- Three extra checks. Each is skipped unless its provider + endpoint are set. ---
# 1. Reverse image search: were the listing photos lifted from another ad?
PHOTO_PROVIDER=
PHOTO_ENDPOINT=
PHOTO_INPUT_TEMPLATE={"url": "{query}"}
# 2. Who really owns the address? Public US property records.
PROPERTY_PROVIDER=
PROPERTY_ENDPOINT=
PROPERTY_INPUT_TEMPLATE={"address": "{query}"}
# 3. Same listing posted in other cities? Exact-phrase web search.
DUPLICATE_PROVIDER=
DUPLICATE_ENDPOINT=
DUPLICATE_INPUT_TEMPLATE={"q": "{query}"}
